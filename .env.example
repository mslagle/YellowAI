# LLM Routing: "hybrid" (local + cloud escalation), "gemini" (cloud only), "bionic" / "lmstudio", or "ollama"
LLM_BACKEND=hybrid
HYBRID_LOCAL_BACKEND=bionic
HYBRID_ESCALATE_ON_STUCK_TURNS=2
HYBRID_ESCALATE_ON_BATTLES=false
HYBRID_CHECKPOINT_TURNS=25

# Cloud Gemini Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-3.5-flash
GEMINI_THINKING_BUDGET=0

# Local Bionic / LM Studio Settings
BIONIC_BASE_URL=http://localhost:1234/v1
BIONIC_MODEL_ID=default

# Local Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=qwen3.5

# Background Input ("postmessage", "lua_socket", or "foreground")
BACKGROUND_INPUT_MODE=postmessage
LUA_BRIDGE_HOST=127.0.0.1
LUA_BRIDGE_PORT=8888

# Tier 0 Reflexes & Token Savings
ENABLE_TIER0_REFLEXES=true
SEND_PREVIOUS_IMAGE_ONLY_WHEN_STUCK=true
MAX_DIALOGUE_HISTORY=20
DIALOGUE_PROMPT_RECENT_COUNT=4

# Timing
TURN_SETTLE_DELAY=0.25

