# Local Ollama VLM Settings (100% offline/local inference on RTX 3060)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=qwen3.5:9b
OLLAMA_NUM_CTX=8192
OLLAMA_THINK_MODE=auto
OLLAMA_SAVE_THINKING_TRACES=true

# Conversation History & Compaction
OLLAMA_HISTORY_MAX_TURNS=18
OLLAMA_HISTORY_KEEP_RECENT=6
OLLAMA_HISTORY_COMPACT_TOKENS=10000

# Internet Search & Discovery Planning
OLLAMA_ENABLE_WEB_SEARCH=true
OLLAMA_AUTO_PLAN_ON_STARTUP=true

# mGBA Background Input ("postmessage" | "lua_socket" | "foreground")
BACKGROUND_INPUT_MODE=postmessage
